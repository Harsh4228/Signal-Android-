# Copy to infra/.env and fill in. Never commit infra/.env.

# Your domain; point its DNS A record at the server's IP first.
DOMAIN=chat.example.com

# Moving to a new domain later: point the new domain's DNS here, set DOMAIN to the new one and put the old one
# here (space separated), then  docker compose up -d . Apps switch to DOMAIN by themselves, keeping accounts and
# chats. Keep the old domain (and its DNS) for a few months, until everyone has opened the app once.
OLD_DOMAINS=

# Admin username(s), comma separated. With an admin set, only admins create accounts.
ADMIN_USERS=harsh

# 1 = anyone can sign up. 0 = only the admin creates accounts.
OPEN_REGISTRATION=0

# Long random secret shared by the server and coturn. Generate with:  openssl rand -hex 32
TURN_SECRET=

# Database password (only used between the containers). Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Public and private IP of the VM (Oracle: instance page -> "Public IP address" / "Private IP address").
# coturn needs both, otherwise calls fail behind Oracle's NAT.
PUBLIC_IP=
PRIVATE_IP=

# ---- Off-site backups (optional, recommended) ----
# Oracle: Storage -> Buckets -> create "meetme-backups" (private); Profile -> Customer Secret Keys -> Generate.
#   S3_ENDPOINT = https://<namespace>.compat.objectstorage.<region>.oraclecloud.com  (namespace: Tenancy details)
#   S3_REGION   = e.g. ap-mumbai-1
# Uncomment COMPOSE_PROFILES to turn it on.
# COMPOSE_PROFILES=offsite
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=meetme-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Encrypts everything before upload. Generate with:  openssl rand -hex 32
# Keep a copy in a password manager: without it the off-site backups cannot be read.
BACKUP_PASSPHRASE=
