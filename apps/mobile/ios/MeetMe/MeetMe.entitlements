<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (content-free wake-ups through Firebase / APNs). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- The folder shared with the Share Extension ("Share" from WhatsApp, Photos... -> CellMate). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.gosite.cellmate</string>
	</array>
</dict>
</plist>
