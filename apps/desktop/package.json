{
  "name": "@meetme/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CellMate secure messenger for Windows / macOS / Linux",
  "main": "out/main/index.js",
  "author": "CellMate",
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config web/vite.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@meetme/core": "*",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
