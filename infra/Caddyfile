# OLD_DOMAINS keeps a previous address working after a domain change, so apps can move over (see .env.example).
{$DOMAIN} {$OLD_DOMAINS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Desktop app auto-updates: put the Desktop workflow's files in infra/updates/.
	handle_path /updates/* {
		root * /srv/updates
		file_server
	}

	# Everything else (incl. WebSockets /v1/ws) goes to the CellMate server.
	handle {
		reverse_proxy server:8080
	}

	# Access logs off: no record of who connected when.
	log {
		output discard
	}
}
